# ---- Server ----
PORT=8080
NODE_ENV=development
# Set to the number of reverse proxies in front of the API (0 = none). Needed for correct client IPs / rate limits.
TRUST_PROXY=0

# ---- Databases ----
MONGO_URI=mongodb://127.0.0.1:27017/tapi_task
REDIS_URL=redis://127.0.0.1:6379

# ---- Auth (use long random values: openssl rand -hex 48) ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# ---- Cache ----
CACHE_EPOCH_PREFIX=tapi:v1

# ---- Email (OTP delivery) ----
# smtp = real delivery (requires EMAIL_USER / EMAIL_PASSWORD), file = write .eml files to .mail-outbox/ (local development only)
EMAIL_TRANSPORT=file
EMAIL_USER=
EMAIL_PASSWORD=
